<p class="notice"><%= notice %></p>
<% content_for :title, @product.name %>
<h1><%= @product.name %></h1>
<%= render @product %>
<div class="actions">
  <%= link_to "Modifier", edit_product_path(@product), class: "btn" %>
  <%= button_to "Supprimer", @product, method: :delete, class: "btn btn--danger", form: { data: { turbo_confirm: "Supprimer ce produit ?" } } %>
</div>
<p><%= link_to "← Retour à la liste", products_path, class: "back" %></p>
