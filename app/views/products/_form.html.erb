<%= form_with(model: product, class: "form") do |form| %>
  <% if product.errors.any? %>
    <div class="form-errors">
      <% product.errors.each do |error| %>
        <p><%= error.message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Produit" %>
    <%= form.text_field :name, placeholder: "ex : Yaourt nature", autofocus: true %>
  </div>

  <div class="field">
    <%= form.label :expires_on, "Date de péremption" %>
    <%= form.date_field :expires_on %>
  </div>

  <div class="field">
    <%= form.label :quantity, "Quantité" %>
    <%= form.number_field :quantity, min: 1, value: product.quantity || 1 %>
  </div>

  <%= form.submit "Enregistrer", class: "btn" %>
<% end %>
